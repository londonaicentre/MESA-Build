{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### {{ _folder_name | capitalize }}: Training data generation"
   ],
   "id": "00000000"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Set up environment (including `assume --env` credentials if required)"
   ],
   "id": "00000001"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "from dotenv import load_dotenv\n",
    "load_dotenv()"
   ],
   "id": "00000002"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from datagen import BedrockBatchGenerator, TrainingDataUploader\n",
    "from {{ schema_name }}.prompt_builder import PromptBuilder\n",
    "from {{ schema_name }} import Schema"
   ],
   "id": "00000003"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pb = PromptBuilder(){% if condition_based %}\n{% endif %}",
    "{% if condition_based %}prompt_parameters: dict[str, str] = {\"condition\": \"{{ condition }}\", \"cui\": \"{{ cui }}\"}{% endif %}"
   ],
   "id": "00000004"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Download documents from batch"
   ],
   "id": "00000005"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen = BedrockBatchGenerator(\n",
    "    system_prompt=pb.build_datagen_prompt({% if condition_based %}prompt_parameters{% endif %}),\n",
    "    schema=Schema,\n",
    "    schema_name=\"{{ schema_name }}\",\n",
    "    model_name=\"sonnet4\",\n",
    "    document_batches=[\"<add document batch>\"],\n",
    ")"
   ],
   "id": "00000006"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen.get_document_files_count()"
   ],
   "id": "00000007"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Sanity check"
   ],
   "id": "00000008"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "##### Start batch generation"
   ],
   "id": "00000009"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen.generate_via_batch(100, os.environ[\"BUCKET\"], os.environ[\"BEDROCK_EXECUTION_ROLE\"])"
   ],
   "id": "0000000a"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "##### Download and parse batch outputs"
   ],
   "id": "0000000b"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen.extract_batch_output(os.environ[\"BUCKET\"])"
   ],
   "id": "0000000c"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Start datagen"
   ],
   "id": "0000000d"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen.generate_via_batch(3000, os.environ[\"BUCKET\"], os.environ[\"BEDROCK_EXECUTION_ROLE\"])"
   ],
   "id": "0000000e"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "gen.extract_batch_output(os.environ[\"BUCKET\"])"
   ],
   "id": "0000000f"
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Upload formatted document:schema pairs as training data"
   ],
   "id": "00000010"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "s3_uri = TrainingDataUploader.upload(\n",
    "    schema=Schema,\n",
    "    schema_name=\"{{ schema_name }}\",\n",
    "    system_prompt=pb.build_main_prompt({% if condition_based %}prompt_parameters{% endif %}),\n",
    "    short_description=\"{{ _folder_name }}-batch\",\n",
    "    long_description=\"Training data for {{ _folder_name | capitalize }}\",\n",
    "    input_folder=Path(\"./data/trainingdata\"),\n",
    "{% if condition_based %}    prompt_parameters=prompt_parameters,\n{% endif %}",
    ")"
   ],
   "id": "00000011"
  }
 ],
