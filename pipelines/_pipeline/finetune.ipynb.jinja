   "source": [
    "import os\n",
    "from dotenv import load_dotenv\n",
    "load_dotenv()"
   ],
   "id": "00000001"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from mesa_runtime import MesaRuntime\n",
    "runtime: MesaRuntime = MesaRuntime(\n",
    "    os.environ[\"BASE_URL\"], os.environ[\"USERNAME\"], os.environ[\"PASSWORD\"]\n",
    ")"
   ],
   "id": "00000002"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "runtime.list_training_data()"
   ],
   "id": "00000003"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "run_id: int = runtime.dispatch(\n",
    "    \"<add training batch>\",\n",
    "    model_name=\"{{ _folder_name }}\",\n",
    "    schema=\"{{ schema_name | replace('schema', '') }}\",\n",
    "    version=\"0.1.0\",\n",
    "    config=\"config.yaml\",\n",
    "    config_from_file=True\n",
    ")"
   ],
   "id": "00000004"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
